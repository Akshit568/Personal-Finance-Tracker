# Base URL for the backend API.
#
# Development: leave as "/api" — the Vite dev server proxies /api to the backend
# (configure the proxy target with VITE_API_PROXY below).
#
# Production build: set this to the full backend URL, e.g. https://api.example.com/api
VITE_API_URL=/api

# Where the Vite dev-server proxy forwards /api requests (development only).
VITE_API_PROXY=http://localhost:5000
