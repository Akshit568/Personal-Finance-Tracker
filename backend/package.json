{
  "name": "personal-finance-tracker-backend",
  "version": "1.0.0",
  "description": "Production-quality backend for a Personal Finance Tracker (Node.js, Express, PostgreSQL, Redis, JWT).",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:schema": "node scripts/runSql.js schema",
    "db:indexes": "node scripts/runSql.js indexes",
    "db:seed": "node scripts/runSql.js seed",
    "db:setup": "node scripts/runSql.js schema && node scripts/runSql.js indexes && node scripts/runSql.js seed"
  },
  "keywords": [
    "finance",
    "express",
    "postgresql",
    "redis",
    "jwt",
    "rbac"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "redis": "^4.7.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
